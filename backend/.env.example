# DSN до ClickHouse-витрины (см. backend/app/reports/warehouse.py). Формат:
#   clickhouse://user:password@host:port/database
# Пример:
# DATABASE_URL=clickhouse://default:secret@localhost:8123/analytics
DATABASE_URL=

# PostgreSQL: хранилище приложения (схема ai_reporter). libpq-формат:
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
# Имя схемы можно переопределить (по умолчанию ai_reporter):
# PG_SCHEMA=ai_reporter
# PGSSLMODE=prefer

# Датасеты Oracle ссылаются на DSN как env:ORACLE_DSN. Формат:
#   oracle://user:password@host:port/service_name  (для SID — ?sid=ORCL)
# Пароль с '@' или '/' обязан быть percent-encoded.
# ORACLE_DSN=oracle://reporter:secret@localhost:1521/FREEPDB1
# Разбор словесного ТЗ в декларацию отчёта (необязателен: без ключа разбор
# делает детерминированный парсер). Ключ берётся из OPENROUTER_API_KEY или из
# файла авторизации opencode.
# OPENROUTER_API_KEY=
# INTERPRET_MODEL=google/gemini-2.5-flash
# INTERPRET_FALLBACK_MODEL=openai/gpt-4o-mini
# Каталог артефактов (загруженные CSV-датасеты).
# Укажите путь на бэкапируемый том, чтобы не потерять файлы.
# ARTIFACTS_DIR=/var/lib/ai-reporter/artifacts
# Режим хранилища: local (диск) | s3 (реализация будет добавлена позже)
# ARTIFACTS_STORAGE=local
