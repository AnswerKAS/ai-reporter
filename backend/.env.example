# DSN до ClickHouse-витрины (см. backend/app/warehouse.py). Формат:
#   clickhouse://user:password@host:port/database
# Пример:
# DATABASE_URL=clickhouse://default:secret@localhost:8123/analytics
DATABASE_URL=
# Модель opencode для генерации report.py (с поддержкой tools):
# OPENCODE_MODEL=openrouter/~deepseek/deepseek-v4-flash-latest
OPENCODE_MODEL=
# Каталог артефактов (report.py, CSV-датасеты, черновики скиллов).
# Укажите путь на бэкапируемый том, чтобы не потерять артефакты.
# ARTIFACTS_DIR=/var/lib/ai-reporter/artifacts
# Режим хранилища: local (диск) | s3 (реализация будет добавлена позже)
# ARTIFACTS_STORAGE=local
