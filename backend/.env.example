# Все подключения приложения к БД живут в одной JSON-переменной.
# Для Docker Compose у metabase host=postgres; для локального запуска — localhost.
# Ключи, кроме metabase, выбираются в форме датасета. У demo — сид витрины.
# Пароли со спецсимволами кодируются в URL (например @ → %40).
DB_CONNECTIONS='{"metabase":{"source":"postgres","dsn":"postgresql://ai_reporter:ai_reporter@postgres:5432/ai_reporter","schema":"ai_reporter","sslmode":"disable"},"demo":{"source":"clickhouse","dsn":"clickhouse://default:demo@clickhouse:8123/default","title":"Демо-витрина","secure":false}}'
# Разбор словесного ТЗ в декларацию отчёта (необязателен: без ключа разбор
# делает детерминированный парсер). В Docker ключ задаётся здесь; файл
# авторизации OpenCode читается только при локальном запуске вне контейнера.
# OPENROUTER_API_KEY=
# INTERPRET_MODEL=google/gemini-2.5-flash
# INTERPRET_FALLBACK_MODEL=openai/gpt-4o-mini
# Каталог артефактов (загруженные CSV-датасеты).
# Укажите путь на бэкапируемый том, чтобы не потерять файлы.
# ARTIFACTS_DIR=/var/lib/ai-reporter/artifacts
# Режим хранилища: local (диск) | s3 (реализация будет добавлена позже)
# ARTIFACTS_STORAGE=local
