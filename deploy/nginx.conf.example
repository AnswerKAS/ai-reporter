# Пример конфига nginx для AI Reporter: статика фронта + прокси API.
# Установка:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/ai-reporter
#   sudo ln -s /etc/nginx/sites-available/ai-reporter /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Для HTTPS: certbot --nginx -d ваш-домен

server {
    listen 80;
    server_name _;  # замените на домен/IP

    root /home/deploy/ai-reporter/frontend/dist;
    index index.html;

    # SPA: все не-файловые пути отдаём через index.html
    location / {
        try_files $uri /index.html;
    }

    # API бэкенда (uvicorn на 127.0.0.1:8000, пути /api/... без рерайта)
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # генерация отчётов/черновиков может ждать дольше обычного
        proxy_read_timeout 300s;
    }
}
