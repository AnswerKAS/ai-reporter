# Copy to langfuse/.env and generate independent random values for every secret.
LF_POSTGRES_PASSWORD=
LF_CLICKHOUSE_PASSWORD=
LF_REDIS_PASSWORD=
LF_MINIO_PASSWORD=
LF_SALT=
LF_ENCRYPTION_KEY=
LF_NEXTAUTH_SECRET=
LF_PUBLIC_KEY=
LF_SECRET_KEY=
LF_ADMIN_EMAIL=admin@ai-reporter.local
LF_ADMIN_PASSWORD=
# Name of the running AI Reporter Compose network.
APP_DOCKER_NETWORK=ai-reporter_default
# Только для compose.proxmox.yml: доступ к существующему Garage S3.
# LF_S3_ACCESS_KEY_ID=
# LF_S3_SECRET_ACCESS_KEY=
# LANGFUSE_PUBLIC_URL=https://langfuse.example.com
# LANGFUSE_S3_PUBLIC_URL=https://s3.example.com
